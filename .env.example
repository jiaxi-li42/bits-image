# Turso (SQLite over the network — libSQL)
# Create a DB at https://turso.tech → copy URL + token.
TURSO_DATABASE_URL="libsql://your-db-name.turso.io"
TURSO_AUTH_TOKEN="your-turso-auth-token"

# Cloudflare R2 (S3-compatible object storage)
# Dashboard → R2 → Manage API tokens. Create a bucket called "bits-image".
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key"
R2_SECRET_ACCESS_KEY="your-r2-secret-key"
R2_BUCKET="bits-image"

# 6-digit passcode that gates the entire app. Send this to invited users
# out-of-band. Rotate by changing the value — every existing session is
# invalidated automatically (the auth cookie is HMAC'd against this).
APP_PASSCODE=""

# Required for scheduled cleanup; an empty value makes the endpoint return 503.
# Generate an independent random secret. vercel.json schedules the production job.
CRON_SECRET=""
